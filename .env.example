# ==============================================================================
# Server & Environment Configuration
# ==============================================================================
# Serverin dinləyəcəyi port nömrəsi
PORT=8080

# Mühit tipi: development | test | production
APP_ENV=development

# Tətbiqin adı (loqlarda və ya cavablarda istifadə üçün)
APP_NAME=ExpenseTrackerAPI

# API marşrut prefiksi (məsələn: /api/v1 və ya boş qoyula bilər)
API_PREFIX=/api/v1

# ==============================================================================
# Database Configuration (SQLite)
# ==============================================================================
# SQLite verilənlər bazası faylının yolu
# Lokal işlədərkən: ./data/expenses.db
# Docker mühitində: /app/data/expenses.db
DB_PATH=./data/expenses.db

# Baza əməliyyatları üçün gözləmə müddəti (timeout)
DB_TIMEOUT=5s

# ==============================================================================
# Logging & Telemetry Configuration
# ==============================================================================
# Loq səviyyəsi: debug | info | warn | error
LOG_LEVEL=debug

# Loq formatı: text (lokal terminal oxunaqlığı üçün) | json (Docker/production üçün)
LOG_FORMAT=text

# ==============================================================================
# CORS Configuration (Frontend / UI inteqrasiyası üçün)
# ==============================================================================
# Vergüllə ayrılmış icazə verilən domenlər
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ==============================================================================
# Security & Rate Limiting (Gələcək mərhələlər üçün)
# ==============================================================================
# Tələb limiti (saniyədə maksimum sorğu sayı)
RATE_LIMIT_RPS=100

# Əgər gələcəkdə JWT autentifikasiyası əlavə olunarsa (gizli açar):
# JWT_SECRET=your-256-bit-secret-key-here
